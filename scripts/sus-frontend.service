[Unit]
Description=SUS Frontend - Next.js
After=network.target sus-backend.service

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/app/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/home/ec2-user/app/frontend/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sus-frontend

[Install]
WantedBy=multi-user.target
